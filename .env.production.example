# ==========================================
# Annapoorna Production Environment Variables
# ==========================================

# Database Configuration
POSTGRES_USER=annapoorna_user
POSTGRES_PASSWORD=generate_a_strong_password_here_min_16_chars
POSTGRES_DB=annapoorna_prod_db

# Security Keys (Generate with: openssl rand -hex 32)
APP_SECRET_KEY=replace_with_a_random_64_character_hex_string
JWT_SECRET_KEY=replace_with_another_random_64_character_hex_string

# Frontend Public API URL
NEXT_PUBLIC_API_URL=https://annapoornawellness.org

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=https://annapoornawellness.org,https://www.annapoornawellness.org,https://api.annapoornawellness.org

# Integrations (Optional)
EMAIL_PROVIDER=console
STORAGE_PROVIDER=local
PAYMENT_PROVIDER=mock
