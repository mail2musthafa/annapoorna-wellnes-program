# ==============================================================================
# Annapoorna Portal - Environment Configuration Template
# ==============================================================================

# Application
APP_NAME="Annapoorna Portal"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_SECRET_KEY=change-this-to-a-super-secret-64-char-key-in-production-annapoorna-portal-secret-key
API_V1_STR=/api/v1
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=annapoorna_user
POSTGRES_PASSWORD=annapoorna_secure_password
POSTGRES_DB=annapoorna_db
DATABASE_URL=postgresql+asyncpg://annapoorna_user:annapoorna_secure_password@localhost:5432/annapoorna_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change-this-jwt-secret-key-for-annapoorna-auth-tokens-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# Background Jobs / Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email Integration (Console, SMTP, SES)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@annapoorna.wellness
EMAIL_FROM_NAME="Annapoorna Portal"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Object Storage (Local, S3, Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=annapoorna-media
S3_ENDPOINT_URL=

# Payment Integration (Mock, Stripe, Razorpay)
PAYMENT_PROVIDER=mock
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Video & Live Class Integration (Mock, Zoom, Daily)
MEETING_PROVIDER=mock
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
VIDEO_HOSTING_PROVIDER=mock

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Annapoorna Portal"
